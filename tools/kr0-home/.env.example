# kr0-home settings. Copy to .env (kr0-home init does it for you). .env is not committed.

# The Drive art folder on this machine.
# Windows, Drive for Desktop: G:\My Drive\kr0 Studio Art  (or a mirrored copy, see README)
KR0_DRIVE_ART=G:\My Drive\kr0 Studio Art

# Scenario API key (Scenario: Settings > API keys). Leave empty to skip Scenario.
SCENARIO_API_KEY=
SCENARIO_API_SECRET=

# Name recorded on every grade and edit.
KR0_WHO=kr0

# Port on 127.0.0.1 for Asset Desk.
KR0_ASSET_DESK_PORT=8765
